<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat DayNight parent is required for per-app locale switching below Android 13.
         The UI is entirely Compose, so the action bar/title are disabled. -->
    <style name="Theme.NoteKeeper" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>